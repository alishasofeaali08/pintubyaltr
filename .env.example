# Server (Node/Express) — loaded by dotenv from .env.local or .env
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/pintu
JWT_SECRET=replace-with-a-long-random-secret
CORS_ORIGIN=http://localhost:5173

# Client (Vite) — only VITE_* variables are exposed to the browser.
# Leave this unset when Express serves the built app on the same origin ("/api").
# Set it when the client and API are deployed separately, e.g.:
# VITE_API_URL=https://pintu-api.example.com/api

# Hosted MongoDB example (MongoDB Atlas):
# MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/pintu?retryWrites=true&w=majority
